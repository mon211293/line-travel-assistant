{
  "name": "line-travel-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "把 Google 日曆裡的旅遊行程,每天早上與活動開始前,透過 LINE 官方帳號推播到旅遊群組",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gcp-build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start:daily": "npm run build && functions-framework --target=dailyItinerary --source=dist/index.js",
    "start:reminder": "npm run build && functions-framework --target=itineraryReminder --source=dist/index.js",
    "start:webhook": "npm run build && functions-framework --target=travelWebhook --source=dist/index.js",
    "start:weather": "npm run build && functions-framework --target=weatherPush --source=dist/index.js",
    "deploy:daily": "gcloud functions deploy dailyItinerary --gen2 --runtime=nodejs20 --region=asia-east1 --source=. --entry-point=dailyItinerary --trigger-http --no-allow-unauthenticated",
    "deploy:reminder": "gcloud functions deploy itineraryReminder --gen2 --runtime=nodejs20 --region=asia-east1 --source=. --entry-point=itineraryReminder --trigger-http --no-allow-unauthenticated",
    "deploy:webhook": "gcloud functions deploy travelWebhook --gen2 --runtime=nodejs20 --region=asia-east1 --source=. --entry-point=travelWebhook --trigger-http --allow-unauthenticated --set-env-vars=GCP_PROJECT_ID=bernie-219fb,LIFF_ID=REPLACE_WITH_LIFF_ID",
    "deploy:weather": "gcloud functions deploy weatherPush --gen2 --runtime=nodejs20 --region=asia-east1 --source=. --entry-point=weatherPush --trigger-http --no-allow-unauthenticated",
    "deploy:scheduled": "gcloud functions deploy scheduledMessagePush --gen2 --runtime=nodejs20 --region=asia-east1 --source=. --entry-point=scheduledMessagePush --trigger-http --no-allow-unauthenticated"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/functions-framework": "^3.4.2",
    "@google-cloud/secret-manager": "^5.6.0",
    "@line/bot-sdk": "^9.5.1",
    "googleapis": "^140.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
